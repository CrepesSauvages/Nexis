{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "plugins/**/*.js"],
  "exclude": ["node_modules"]
}
