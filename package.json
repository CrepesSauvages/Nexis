{
  "name": "nexis",
  "version": "0.0.1",
  "description": "Nexis a bot discord, fully customisable in Js",
  "keywords": [
    "discord",
    "bot",
    "multi"
  ],
  "license": "ISC",
  "author": "Crepes_Sauvages",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "deploy-commands": "node src/deploy-commands.js",
    "release": "release-it",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.js": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  }
}
